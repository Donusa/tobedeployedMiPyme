# ============================================================
# MiPyme - Variables de entorno
# ============================================================
# Copiar este archivo como .env y completar con los valores apropiados.
# ============================================================

# --- Base de datos ---
DB_URL=jdbc:mysql://localhost:3306/mipyme?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=86400

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- TiendaNube ---
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_WEBHOOK_BASE_URL=
TIENDANUBE_REDIRECT_URI=

# --- MercadoLibre ---
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=

# --- WhatsApp / Meta ---
WPP_WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v25.0
CONNECT_SESSION_TTL_MIN=10
WPP_SKIP_SIG=false

# --- MercadoPago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=

# --- Frontend ---
FACEBOOK_APP_ID=
FACEBOOK_SDK_VERSION=v25.0
PROXY_BACKEND_URL=http://localhost:8080
